{
  "name": "imaginecode",
  "productName": "ImagineCode",
  "version": "1.0.0",
  "description": "The IDE for programming languages that don't exist yet — imagine your own language, Claude Code compiles it into a real website.",
  "author": {
    "name": "ImagineCode"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "web:dev": "node --watch server.js",
    "icons": "electron scripts/make-icons.cjs",
    "pack": "npm run icons && electron-builder --dir",
    "dist": "npm run icons && electron-builder --win nsis",
    "dist:mac": "npm run icons && electron-builder --mac",
    "dist:mac:arm": "npm run icons && electron-builder --mac dmg --arm64",
    "dist:mac:intel": "npm run icons && electron-builder --mac dmg --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "express": "^4.21.2",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.imaginecode.app",
    "productName": "ImagineCode",
    "copyright": "ImagineCode — there are no syntax errors in imagination",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "**/*",
      "!.claude${/*}",
      "!dist${/*}",
      "!landing${/*}",
      "!scripts${/*}",
      "!workspace${/*}",
      "!output${/*}",
      "!.imaginecode-keys.json",
      "!.imaginecode-prefs.json",
      "!.imaginecode-rules.json",
      "!**/*.map",
      "!node_modules/monaco-editor/{dev,esm,min-maps}${/*}",
      "!node_modules/monaco-editor/*.d.ts",
      "!node_modules/@anthropic-ai/claude-agent-sdk/*.d.ts",
      "!**/{test,tests,__tests__,powered-test,example,examples}${/*}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ImagineCode",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "MIT — there are no syntax errors in imagination"
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "title": "ImagineCode ${version}",
      "backgroundColor": "#08080a",
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 158,
          "y": 190,
          "type": "file"
        },
        {
          "x": 402,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "compression": "maximum"
  }
}
