# dependencies — restored with `npm install`
node_modules/

# compiled imagination — regenerated on every Run
output/

# your provider API keys — never commit these
.imaginecode-keys.json

# local preferences (have you seen the introduction, …)
.imaginecode-prefs.json

# the rules of the language you invented — yours, not the repo's
.imaginecode-rules.json

# packaged desktop builds — rebuilt with `npm run dist`
dist/

# rendered icons — rebuilt with `npm run icons` from build/*.svg
build/icon.png
build/icon-256.png
build/icon.ico
# build/icon.icns is deliberately NOT ignored: the macOS runner packages the
# .dmg without a display, so it can't rasterise the SVG the way `npm run icons`
# does. The committed .icns is what electron-builder stamps onto the .app.

# logs & OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
